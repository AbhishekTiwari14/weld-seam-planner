{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "kind": {
      "type": "string",
      "const": "weld-plan"
    },
    "jobId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "workpiece": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "source": {
          "type": "object",
          "properties": {
            "filename": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^[^/\\\\\\u0000-\\u001f]+$"
            },
            "byteLength": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "encoding": {
              "type": "string",
              "enum": [
                "ascii",
                "binary"
              ]
            },
            "unit": {
              "type": "string",
              "enum": [
                "mm",
                "cm",
                "m",
                "in"
              ]
            },
            "inputTriangles": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "omittedDegenerateTriangles": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "filename",
            "byteLength",
            "sha256",
            "encoding",
            "unit",
            "inputTriangles",
            "omittedDegenerateTriangles"
          ],
          "additionalProperties": false
        },
        "frame": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "const": "workpiece"
            },
            "lengthUnit": {
              "type": "string",
              "const": "mm"
            },
            "axes": {
              "type": "string",
              "const": "source_xyz"
            },
            "origin": {
              "type": "string",
              "const": "source_origin"
            },
            "handedness": {
              "type": "string",
              "const": "right"
            }
          },
          "required": [
            "id",
            "lengthUnit",
            "axes",
            "origin",
            "handedness"
          ],
          "additionalProperties": false
        },
        "boundsMm": {
          "type": "object",
          "properties": {
            "min": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 3,
              "maxItems": 3
            },
            "max": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 3,
              "maxItems": 3
            }
          },
          "required": [
            "min",
            "max"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "source",
        "frame",
        "boundsMm"
      ],
      "additionalProperties": false
    },
    "processProfile": {
      "type": "string",
      "const": "generic-arc-targets-v1"
    },
    "seams": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "geometry": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "polyline"
              },
              "points": {
                "minItems": 2,
                "maxItems": 1000,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "positionMm": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "number"
                        }
                      ],
                      "items": false,
                      "minItems": 3,
                      "maxItems": 3
                    }
                  },
                  "required": [
                    "id",
                    "positionMm"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "type",
              "points"
            ],
            "additionalProperties": false
          },
          "parameters": {
            "type": "object",
            "properties": {
              "travelSpeedMmPerS": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "currentTargetA": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "voltageTargetV": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "travelSpeedMmPerS",
              "currentTargetA",
              "voltageTargetV"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "geometry",
          "parameters"
        ],
        "additionalProperties": false
      }
    },
    "sequence": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "rulesetVersion": {
          "type": "string",
          "const": "1.0.0"
        },
        "warnings": {
          "maxItems": 20000,
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "const": "TURN_ANGLE_HIGH"
                  },
                  "seamId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "pointId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "valueDeg": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 180
                  }
                },
                "required": [
                  "code",
                  "seamId",
                  "pointId",
                  "valueDeg"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "const": "SHORT_SEGMENT"
                  },
                  "seamId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "startPointId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "endPointId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "valueMm": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "code",
                  "seamId",
                  "startPointId",
                  "endPointId",
                  "valueMm"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "const": "DEGENERATE_TRIANGLES_OMITTED"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "code",
                  "count"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "notAssessed": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "const": "surface_conformance"
            },
            {
              "type": "string",
              "const": "process_suitability"
            },
            {
              "type": "string",
              "const": "torch_orientation"
            },
            {
              "type": "string",
              "const": "workpiece_to_robot_registration"
            },
            {
              "type": "string",
              "const": "robot_kinematics"
            },
            {
              "type": "string",
              "const": "collision_avoidance"
            },
            {
              "type": "string",
              "const": "motion_timing"
            },
            {
              "type": "string",
              "const": "inter_seam_transfers"
            }
          ],
          "items": false,
          "minItems": 8,
          "maxItems": 8
        }
      },
      "required": [
        "rulesetVersion",
        "warnings",
        "notAssessed"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "jobId",
    "revision",
    "workpiece",
    "processProfile",
    "seams",
    "sequence",
    "review"
  ],
  "additionalProperties": false,
  "$id": "urn:weld-seam-planner:weld-job:1.0.0",
  "title": "Controller-neutral weld plan v1",
  "description": "Structural validation only; also apply the documented semantic rules. Not a robot trajectory."
}
